rules_version = '2';
// Deploy: firebase deploy --only firestore:rules   (see README → Community setup)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function str(v, max) { return v is string && v.size() <= max; }
    // A user may add only themselves to reportedBy, once; nothing else may change.
    function reportOnly() {
      let before = resource.data.get('reportedBy', []);
      let after = request.resource.data.get('reportedBy', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportedBy'])
        && after.size() == before.size() + 1
        && request.auth.uid in after && !(request.auth.uid in before);
    }
    function validPlace(d) {
      return str(d.name, 120) && d.name.size() > 0 && str(d.region, 120)
        && d.lat is number && d.lat >= -90 && d.lat <= 90 && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.photos is list && d.photos.size() <= 3
        && str(d.description, 4000) && str(d.guide, 8000) && str(d.tips, 8000);
    }

    match /places/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.reportedBy == [] && validPlace(request.resource.data);
      allow update: if signedIn() && (reportOnly() || (resource.data.addedBy == request.auth.uid
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.reportedBy == resource.data.reportedBy
        && validPlace(request.resource.data)));
      allow delete: if signedIn() && resource.data.addedBy == request.auth.uid;
    }

    match /reels/{code} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.reportedBy == []
        && request.resource.data.url in ['https://www.instagram.com/reel/' + code + '/', 'https://www.instagram.com/p/' + code + '/']
        && str(request.resource.data.caption, 5000) && str(request.resource.data.placeKey, 100)
        && str(request.resource.data.get('seen', ''), 5000) && str(request.resource.data.get('summary', ''), 1000);
      allow update: if signedIn() && reportOnly();
      allow delete: if signedIn() && resource.data.addedBy == request.auth.uid;
    }
  }
}
